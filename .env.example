# ContarStock v2 - Variables de Entorno
# Copiar a .env y completar los valores

# =============================================================================
# MONITORING (Opcional - solo para producción)
# =============================================================================

# Sentry - Error Tracking
# Obtener de: https://sentry.io/settings/<org>/projects/<project>/keys/
# Ejemplo: https://abc123@sentry.io/456789
VITE_SENTRY_DSN=

# Google Analytics 4
# Obtener de: https://analytics.google.com > Admin > Data Streams > Web Stream
VITE_GA_MEASUREMENT_ID=

# =============================================================================
# APLICACIÓN
# =============================================================================

# Versión de la app (mostrada en settings/about)
VITE_APP_VERSION=3.1.1

# =============================================================================
# FEATURE FLAGS (Opcional)
# =============================================================================

# Habilitar analytics (requiere GA_MEASUREMENT_ID)
VITE_ENABLE_ANALYTICS=false

# Habilitar session replays en Sentry (consume más recursos)
VITE_ENABLE_REPLAYS=false

# =============================================================================
# NOTAS
# =============================================================================
#
# 1. Copiar este archivo a .env
# 2. Completar los valores deseados
# 3. NUNCA hacer commit del archivo .env
# 4. Las variables sin valor serán ignoradas
#
